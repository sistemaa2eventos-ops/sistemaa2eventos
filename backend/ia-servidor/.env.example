# Servidor de IA central (PC com placa de vídeo). Copie para .env e preencha.
# O token aparece UMA vez no painel: Configurações > Câmeras e IA facial > Motor de IA > Servidores de IA.
VPS_URL=https://painel.nzt.app.br
SERVIDOR_TOKEN=
SERVIDOR_NOME=Servidor de IA
# Motor de IA deste PC (o ligar-servidor-ia.bat o inicia)
IA_URL=http://127.0.0.1:8000
