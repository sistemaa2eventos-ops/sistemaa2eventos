{
  "venvPath": "backend/microservice-face-python",
  "venv": "venv-ia",
  "pythonPath": "backend/microservice-face-python/venv-ia/Scripts/python.exe",
  "extraPaths": [
    "backend/microservice-face-python/src",
    "backend/microservice-face-python/venv-ia/Lib/site-packages"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/venv",
    "**/.venv",
    "**/venv-ia",
    "**/a2-eventos",
    "**/scratch",
    "**/dist"
  ],
  "typeCheckingMode": "off",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
